# Create .env from this file. Never commit .env.

# Required for signed-in browser sessions.
SESSION_SECRET=replace-with-a-long-random-secret

# Required for the shareable read-only demo API. Send it as the X-API-Key header.
# This key does not grant partner API or MCP access.
RATE_NINJA_API_KEY=replace-with-a-separate-demo-api-key

# Admin reference API and admin CLI (X-Admin-API-Key). Must be ≥32 characters
# and must not equal RATE_NINJA_API_KEY. Never share with partners.
# The rate-ninja-cloudbbs-post cron service needs only this and CLOUDBBS_TOKEN.
# RATE_NINJA_ADMIN_API_KEY=

# CloudBBS project announcement post (option 9 / post-cloudbbs), from the local
# CLI and the rate-ninja-cloudbbs-post cron. That cron needs only
# RATE_NINJA_ADMIN_API_KEY and CLOUDBBS_TOKEN.
# CLOUDBBS_TOKEN=

# Shared CloudBBS destination for the CLI and server.
# CLOUDBBS_URL=https://cloudbbs.ai
# CLOUDBBS_PROJECT=rn

# Render service token for reading the current agent booking code from CloudBBS.
# Use a dedicated agent token without the announcement flag.
# CLOUDBBS_SERVER_TOKEN=

# Client agent (option 10 / client-agent). Local only. Uses a buyer API key
# (D-035) and a CloudBBS agent token — never CLOUDBBS_TOKEN.
# RATE_NINJA_BUYER_API_KEY=
# CLOUDBBS_AGENT_TOKEN=
# CLOUDBBS_AGENT_NAME=rateninja-client-agent
# ANTHROPIC_API_KEY=
# CLIENT_AGENT_MODEL=claude-sonnet-5-5

# Signs partner access tokens. Optional locally; falls back to SESSION_SECRET.
# OAUTH_SIGNING_SECRET=replace-with-a-second-long-random-secret

# Partner OAuth, partner API, and MCP. Leave false on the Render service until
# the security gates in the partner PRD are accepted. The app is not live.
# PARTNER_OAUTH_ENABLED=false

# Password reset mail via Resend. If either value is missing, reset requests
# still succeed and do not reveal whether the account exists. Do not commit keys.
# RESEND_API_KEY=
# RESEND_FROM=Rate Ninja <reset@example.com>

# Absolute origin used in password-reset links. Request Host and
# X-Forwarded-Host are ignored. Defaults to the Render service origin.
# PUBLIC_ORIGIN=https://rate-ninja.onrender.com

# Optional. Defaults to data/rateninja.db (local) or the Render disk path in production.
# SQLITE_DB_PATH=/var/data/rateninja.db

# ForteL2 approval receipts. Set all three credentials to enable the sender.
# FORTEL2_RECEIPT_PRIVATE_KEY
# FORTEL2_CF_ACCESS_CLIENT_ID
# FORTEL2_CF_ACCESS_CLIENT_SECRET
# Optional ForteL2 Sepolia overrides.
# FORTEL2_CHAIN_ID
# FORTEL2_WRITE_RPC_URL
# FORTEL2_READ_RPC_URL
# FORTEL2_EXPLORER_URL
