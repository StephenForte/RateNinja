# Create .env from this file. Never commit .env.

# Required for signed-in browser sessions.
SESSION_SECRET=replace-with-a-long-random-secret

# Required for the shareable read-only demo API. Send it as the X-API-Key header.
# This key does not grant partner API or MCP access.
RATE_NINJA_API_KEY=replace-with-a-separate-demo-api-key

# Signs partner access tokens. Optional locally; falls back to SESSION_SECRET.
# OAUTH_SIGNING_SECRET=replace-with-a-second-long-random-secret

# Partner OAuth, partner API, and MCP. Leave false on the Render service until
# the security gates in the partner PRD are accepted. The app is not live.
# PARTNER_OAUTH_ENABLED=false

# Password reset mail via Resend. If either value is missing, reset requests
# still succeed and do not reveal whether the account exists. Do not commit keys.
# RESEND_API_KEY=
# RESEND_FROM=Rate Ninja <reset@example.com>

# Absolute origin used in password-reset links. Request Host and
# X-Forwarded-Host are ignored. Defaults to the Render service origin.
# PUBLIC_ORIGIN=https://rate-ninja.onrender.com

# Optional. Defaults to data/rateninja.db (local) or the Render disk path in production.
# SQLITE_DB_PATH=/var/data/rateninja.db

# --- One-time Airtable → SQLite migration only (`npm run migrate`) ---
# Not used by the running server after the cutover.
# AIRTABLE_PAT=replace-with-airtable-pat
# AIRTABLE_BASE_ID=appBLegnJMAienppq
# AIRTABLE_RATE_TABLE_ID=tbl5OpIdW2kyRRWLp
# AIRTABLE_USER_TABLE_ID=tblwtjp73CaWe3GKy
# AIRTABLE_COMPANY_TABLE_ID=CompanyReference
# AIRTABLE_SAILINGS_TABLE_ID=Sailings
